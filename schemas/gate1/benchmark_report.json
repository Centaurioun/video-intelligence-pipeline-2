{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate1.benchmark_report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "comparison_id",
    "validity",
    "benchmark_status",
    "primary_metric_id",
    "primary_value",
    "arm_values",
    "coverage",
    "failure_class",
    "conclusion"
  ],
  "properties": {
    "comparison_id": {"type": "string", "minLength": 1},
    "validity": {"enum": ["VALID", "INVALID_PROTOCOL"]},
    "benchmark_status": {"enum": ["PLANNED", "VALID", "INVALID_PROTOCOL", "PASS", "FAIL", "NOT_RUN"]},
    "primary_metric_id": {"type": "string", "minLength": 1},
    "primary_value": {"type": ["number", "null"]},
    "arm_values": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {"^[A-Za-z0-9._:-]+$": {"type": "number"}}
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {"^[A-Za-z0-9._:-]+$": {"type": "integer", "minimum": 0}}
    },
    "failure_class": {"type": ["string", "null"]},
    "conclusion": {"type": "string", "minLength": 1}
  }
}
