{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vip_fvs.corpus_separation_evidence.v1",
  "title": "VIP FVS corpus separation synthetic evidence envelope v1",
  "description": "P1 metadata-only envelope. Synthetic fixtures are not real issuer, rights, corpus, or media evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "evidence_state", "issuer_policy_ref", "run_id", "corpus_id", "inventory", "relation_inventory", "split", "evaluation_membership", "development_membership", "label_version_refs", "policy_rights_refs", "candidate", "candidate_relation", "trust"],
  "properties": {
    "schema_version": {"const": "vip_fvs.corpus_separation_evidence.v1"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "evidence_state": {"const": "SYNTHETIC_ONLY"},
    "issuer_policy_ref": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "corpus_id": {"$ref": "#/$defs/id"},
    "inventory": {"type": "object", "additionalProperties": false, "required": ["records", "digest", "run_id", "producer_id"], "properties": {"records": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["revision_id", "source_sha256", "status"], "properties": {"revision_id": {"$ref": "#/$defs/id"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "status": {"enum": ["INCLUDED", "EXCLUDED", "NOT_OBSERVED"]}}}}, "digest": {"$ref": "#/$defs/sha256"}, "run_id": {"$ref": "#/$defs/id"}, "producer_id": {"$ref": "#/$defs/id"}}},
    "relation_inventory": {"type": "object", "additionalProperties": false, "required": ["nodes", "edges", "digest", "run_id", "producer_id"], "properties": {"nodes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}, "digest": {"$ref": "#/$defs/sha256"}, "run_id": {"$ref": "#/$defs/id"}, "producer_id": {"$ref": "#/$defs/id"}}},
    "split": {"type": "object", "additionalProperties": false, "required": ["allocations", "relation_inventory_digest", "run_id", "producer_id"], "properties": {"allocations": {"type": "object", "additionalProperties": {"enum": ["EVALUATION", "DEVELOPMENT"]}}, "relation_inventory_digest": {"$ref": "#/$defs/sha256"}, "run_id": {"$ref": "#/$defs/id"}, "producer_id": {"$ref": "#/$defs/id"}}},
    "evaluation_membership": {"$ref": "#/$defs/membership"},
    "development_membership": {"$ref": "#/$defs/membership"},
    "label_version_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact_ref"}},
    "policy_rights_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "status", "run_id", "producer_id"], "properties": {"artifact_id": {"$ref": "#/$defs/id"}, "status": {"const": "ALLOW"}, "run_id": {"$ref": "#/$defs/id"}, "producer_id": {"$ref": "#/$defs/id"}}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["revision_id", "source_sha256"], "properties": {"revision_id": {"$ref": "#/$defs/id"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "locator": {"type": "string"}, "corpus_role": {"const": "GATE3_PILOT_CANDIDATE"}}},
    "candidate_relation": {"type": "object", "additionalProperties": false, "required": ["nodes", "edges", "claimed_complete", "method_ref", "authorization_scope_digest", "run_id", "producer_id", "inventory_digest", "split_digest", "gate0_relation_digest"], "properties": {"nodes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}, "claimed_complete": {"const": true}, "method_ref": {"$ref": "#/$defs/id"}, "authorization_scope_digest": {"$ref": "#/$defs/sha256"}, "run_id": {"$ref": "#/$defs/id"}, "producer_id": {"$ref": "#/$defs/id"}, "inventory_digest": {"$ref": "#/$defs/sha256"}, "split_digest": {"$ref": "#/$defs/sha256"}, "gate0_relation_digest": {"$ref": "#/$defs/sha256"}}},
    "trust": {"type": "object", "additionalProperties": false, "required": ["issuer_ref", "acceptance_ref", "revocation_ref", "accepted", "revoked", "accepted_producer_ids"], "properties": {"issuer_ref": {"$ref": "#/$defs/id"}, "acceptance_ref": {"$ref": "#/$defs/id"}, "revocation_ref": {"$ref": "#/$defs/id"}, "accepted": {"type": "boolean"}, "revoked": {"type": "boolean"}, "accepted_producer_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "evidence_state": {"const": "SYNTHETIC_ONLY"}}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "edge": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/id"}},
    "membership": {"type": "object", "additionalProperties": false, "required": ["revision_ids", "count", "run_id", "producer_id"], "properties": {"revision_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "count": {"type": "integer", "minimum": 1}, "run_id": {"$ref": "#/$defs/id"}, "producer_id": {"$ref": "#/$defs/id"}}},
    "artifact_ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "digest", "run_id", "producer_id"], "properties": {"artifact_id": {"$ref": "#/$defs/id"}, "digest": {"$ref": "#/$defs/sha256"}, "run_id": {"$ref": "#/$defs/id"}, "producer_id": {"$ref": "#/$defs/id"}}}
  }
}
