{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://video-intelligence-pipeline.invalid/schema/vip_fvs/real_preview_receipt.v1.json",
  "title": "VIP FVS local REAL non-production preview receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_id", "run_id", "attempt_id", "status", "scope", "source", "lifecycle", "authorization", "preview", "verifier", "technical_qc", "tooling", "production_eligible", "export_eligible", "NOT_OBSERVED", "record_digest"],
  "properties": {
    "schema": {"const": "vip_fvs.real_preview_receipt.v1"},
    "record_digest": {"$ref": "#/$defs/digest"},
    "receipt_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["SUCCEEDED", "REFUSED", "FAILED"]},
    "scope": {"const": "LOCAL_REAL_NON_PRODUCTION_PREVIEW"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_revision_id", "source_sha256", "source_byte_count", "selected_stream_index", "timebase"],
      "properties": {
        "source_revision_id": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/digest"},
        "source_byte_count": {"type": "integer", "minimum": 0},
        "selected_stream_index": {"type": "integer", "minimum": 0},
        "timebase": {"$ref": "#/$defs/timebase"}
      }
    },
    "lifecycle": {"$ref": "#/$defs/digested_refs"},
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["authorization_id", "authorization_digest", "policy_identity", "scope"],
      "properties": {
        "authorization_id": {"type": "string", "minLength": 1},
        "authorization_digest": {"$ref": "#/$defs/digest"},
        "policy_identity": {"type": "string", "minLength": 1},
        "scope": {"const": "NON_PRODUCTION_PREVIEW"}
      }
    },
    "preview": {
      "type": "object", "additionalProperties": false,
      "required": ["output_ref", "output_sha256", "output_byte_count", "source_sha256_before", "source_sha256_after", "source_byte_count_before", "source_byte_count_after", "source_start_pts", "source_end_pts", "preview_digest"],
      "properties": {
        "output_ref": {"type": "string", "minLength": 1},
        "output_sha256": {"$ref": "#/$defs/digest"},
        "output_byte_count": {"type": "integer", "minimum": 0},
        "source_sha256_before": {"$ref": "#/$defs/digest"},
        "source_sha256_after": {"$ref": "#/$defs/digest"},
        "source_byte_count_before": {"type": "integer", "minimum": 0},
        "source_byte_count_after": {"type": "integer", "minimum": 0},
        "source_start_pts": {"type": "integer", "minimum": 0},
        "source_end_pts": {"type": "integer", "minimum": 0},
        "preview_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "verifier": {"$ref": "#/$defs/attestation"},
    "technical_qc": {"$ref": "#/$defs/attestation"},
    "tooling": {
      "type": "object", "additionalProperties": false,
      "required": ["ffprobe_digest", "ffmpeg_digest", "configuration_digest"],
      "properties": {
        "ffprobe_digest": {"$ref": "#/$defs/digest"},
        "ffmpeg_digest": {"$ref": "#/$defs/digest"},
        "configuration_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "production_eligible": {"const": false},
    "export_eligible": {"const": false},
    "NOT_OBSERVED": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timebase": {
      "type": "object", "additionalProperties": false,
      "required": ["num", "den"],
      "properties": {"num": {"type": "integer", "minimum": 1}, "den": {"type": "integer", "minimum": 1}}
    },
    "digested_refs": {
      "type": "object", "additionalProperties": false,
      "required": ["review_bundle_ref", "review_bundle_digest", "review_bundle_dependency_digest", "decision_ref", "decision_digest", "plan_ref", "plan_digest", "placement_digest", "mapping_digest"],
      "properties": {
        "review_bundle_ref": {"type": "string", "minLength": 1},
        "review_bundle_digest": {"$ref": "#/$defs/digest"},
        "review_bundle_dependency_digest": {"$ref": "#/$defs/digest"},
        "decision_ref": {"type": "string", "minLength": 1},
        "decision_digest": {"$ref": "#/$defs/digest"},
        "plan_ref": {"type": "string", "minLength": 1},
        "plan_digest": {"$ref": "#/$defs/digest"},
        "placement_digest": {"$ref": "#/$defs/digest"},
        "mapping_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "attestation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "attempt_id", "digest", "artifact_ref", "evidence_class"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "NOT_OBSERVED"]},
        "attempt_id": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"},
        "artifact_ref": {"type": "string", "minLength": 1},
        "evidence_class": {"const": "MEASURED"}
      }
    }
  }
}
